# Email Service Configuration
# Choose one of the following email services and configure accordingly

# Option 1: Resend (Recommended - https://resend.com/)
# RESEND_API_KEY=your_resend_api_key_here

# Option 2: SendGrid (https://sendgrid.com/)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Option 3: AWS SES
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Contact Form Settings
CONTACT_EMAIL_TO=contact@axisautomated.com
CONTACT_EMAIL_FROM=noreply@axisautomated.com

# Next.js Configuration
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
